# Environment template. Copy to .env and change the secret before exposing
# the server to a network.

# Required in production. At least 32 random characters.
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Set to true when serving over HTTPS. The session cookie then includes Secure.
COOKIE_SECURE=false

# The public origin used for CSRF checks and CORS. Include the port.
PUBLIC_ORIGIN=http://localhost:8080

# Listening port (host mapping uses ${PORT} too).
PORT=8080

# Storage
DATA_DIR=./data
DB_PATH=./data/venera.db

# Logging: debug | info | warning | error
LOG_LEVEL=info

# JS source runtime
JS_TIMEOUT_MS=30000
JS_CONCURRENCY=8

# Limits
RATE_LIMIT_PER_MINUTE=300
MAX_UPLOAD_BYTES=536870912

# Static frontend build (inside the image: /app/frontend/dist)
STATIC_DIR=./frontend/dist

APP_VERSION=1.0.0
